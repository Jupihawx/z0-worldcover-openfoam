FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Kinematic pressure (simpleFoam), p/rho

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    "(sides|top)"
    {
        type            symmetry;
    }
    "(inlet|Buildings|Terrain)"
    {
        type            zeroGradient;
    }
}
