FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include        "include/ABLConditions"

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform $Uvector;

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletVelocity;   // log profile from Uref, Zref, z0In, flowDir
        #include        "include/ABLConditions"
        value           uniform $Uvector;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform $Uvector;
    }
    "(sides|top)"
    {
        type            symmetry;
    }
    "(Buildings|Terrain)"
    {
        type            noSlip;
    }
}
// ************************************************************************* //
