FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// SIMPLEC (consistent) with high relaxation for speed.
// If it diverges in the first ~50 iterations: consistent no; p 0.3; U, k, epsilon 0.5.

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.05;
    }
    "(U|k|epsilon)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        nSweeps         1;
    }
}

SIMPLE
{
    consistent          yes;
    momentumPredictor   yes;
    nNonOrthogonalCorrectors 1;
    residualControl
    {
        p               1e-5;
        U               1e-6;
        "(k|epsilon)"   1e-6;
    }
}

relaxationFactors
{
    fields
    {
        p               0.5;
    }
    equations
    {
        U               0.7;
        "(k|epsilon)"   0.7;
    }
}
// ************************************************************************* //
